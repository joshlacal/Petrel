{
  "version": 1,
  "description": "Ordered presentations, already signature- and token-verified, offered to one replay store keyed on (credential issuer, nonce). Each step's created/expires/nonce passed the freshness checks at now_sec, and its credential token (exp = credential_exp) passed the token checks. A nonce is remembered while the presentation could still verify: until created + max_signature_age_secs, expires + max_clock_skew_secs, or credential_exp + credential_expiry_skew_secs, whichever comes first.",
  "max_signature_age_secs": 300,
  "max_clock_skew_secs": 30,
  "credential_expiry_skew_secs": 60,
  "steps": [
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000000,
      "expect": "accept",
      "note": "first use"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000001,
      "expect": "reject",
      "note": "same issuer and nonce inside the window"
    },
    {
      "issuer": "did:web:authority-b.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000001,
      "expect": "accept",
      "note": "same nonce under another issuer"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-2",
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000002,
      "expect": "accept",
      "note": "new nonce"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": null,
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000002,
      "expect": "accept",
      "note": "no nonce: untracked"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": null,
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000003,
      "expect": "accept",
      "note": "no nonce again: still untracked"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-1",
      "created": 1800000000,
      "expires": null,
      "credential_exp": 1800003600,
      "now_sec": 1800000300,
      "expect": "reject",
      "note": "last second the created window accepts"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "credential_exp": 1800001000,
      "now_sec": 1800000010,
      "expect": "accept",
      "note": "no created: first use"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "credential_exp": 1800001000,
      "now_sec": 1800000339,
      "expect": "reject",
      "note": "no created: seen 329 s ago"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "credential_exp": 1800001000,
      "now_sec": 1800000340,
      "expect": "reject",
      "note": "no created: the credential is still valid, so the nonce is still remembered"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-3",
      "created": null,
      "expires": null,
      "credential_exp": 1800001000,
      "now_sec": 1800001060,
      "expect": "reject",
      "note": "no created: last second the credential (+60 s skew) accepts"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-4",
      "created": 1800000400,
      "expires": 1800000410,
      "credential_exp": 1800003600,
      "now_sec": 1800000400,
      "expect": "accept",
      "note": "expires bounds the window"
    },
    {
      "issuer": "did:web:authority-a.example.com",
      "nonce": "n-4",
      "created": 1800000400,
      "expires": 1800000410,
      "credential_exp": 1800003600,
      "now_sec": 1800000440,
      "expect": "reject",
      "note": "last second expires (+30 s skew) accepts"
    }
  ]
}
