{
  "$comment": "Generation manifest for the public Petrel core package. Paths are relative to the repo root (the directory run.py is invoked from).",
  "package": {
    "kind": "core",
    "name": "Petrel",
    "core_namespace_roots": ["blue"]
  },
  "lexicons": {
    "emit": ["generator/lexicons"],
    "reference": [],
    "exclude_namespaces": ["tools.ozone", "internal.bsky"]
  },
  "swift": {
    "output": "Sources/Petrel/Generated",
    "emit_server_contracts": ["com.atproto.space", "com.atproto.memberspace", "com.atproto.managedspace", "com.atproto.personalspace"],
    "$comment_property_type_overrides": "Lexicon types these DID documents as `unknown`. Petrel ships a hand-written DIDDocument model, so the core package types them with it. Keyed by lexicon id, then `<StructName>.<property>`.",
    "property_type_overrides": {
      "com.atproto.identity.defs": {"IdentityInfo.didDoc": "DIDDocument"},
      "com.atproto.identity.resolveDid": {"Output.didDoc": "DIDDocument"},
      "com.atproto.repo.describeRepo": {"Output.didDoc": "DIDDocument"},
      "com.atproto.server.createAccount": {"Output.didDoc": "DIDDocument"},
      "com.atproto.server.createSession": {"Output.didDoc": "DIDDocument"},
      "com.atproto.server.getSession": {"Output.didDoc": "DIDDocument"},
      "com.atproto.server.refreshSession": {"Output.didDoc": "DIDDocument"}
    },
    "$comment_lexicon_documents": "The emitted Lexicon documents as JSON, for the PetrelLexicon runtime validator (LexiconCatalog.bundled()).",
    "lexicon_documents": {"output": "Sources/PetrelLexicon/Generated", "type": "BundledLexiconDocuments"}
  },
  "kotlin": {
    "output": "kotlin/src/main/kotlin/blue/catbird/petrel/generated"
  }
}
