/**
 * {{ description | escapeComment }}
 *
 * Endpoint: {{ endpoint | escapeStringLiteral }}
 */
suspend fun {{ receiver_type }}.{{ function_name }}(
    {% if has_input and has_parameters %}input: {{ input_type }},
    params: {{ parameters_type }}{% elif has_input %}input: {{ input_type }}{% elif has_parameters %}params: {{ parameters_type }}{% endif %}
): ATProtoResponse<{% if output_type %}{{ output_type }}{% else %}Unit{% endif %}> {
    val endpoint = "{{ endpoint | escapeStringLiteral }}"

    {% if has_input %}
    {% if is_blob_upload %}
    // Blob upload - input.data is ByteArray
    val body = input.data
    val contentType = "*/*"
    {% elif is_binary_data %}
    // Binary data
    val body = input.data
    val contentType = "{{ input_encoding | escapeStringLiteral }}"
    {% else %}
    // JSON serialization
    val body = Json.encodeToString(input)
    val contentType = "{{ input_encoding | escapeStringLiteral }}"
    {% endif %}
    {% else %}
    val body: String? = null
    val contentType = "application/json"
    {% endif %}

    {% if has_parameters %}
    // List<Pair<String, String>> preserves repeated keys, which ATProto
    // array-valued query params rely on (e.g. `?actors=a&actors=b`).
    val queryItems = params.toQueryItems()
    {% else %}
    val queryItems: List<Pair<String, String>>? = null
    {% endif %}

    {% if output_is_binary %}
    // Raw (non-JSON) body: fetch the bytes, then wrap them. The output wrapper
    // is not JSON-decodable from a binary body.
    val raw = client.networkService.performRequest<ByteArray>(
        method = "POST",
        endpoint = endpoint,
        queryItems = queryItems,
        headers = mapOf(
            "Content-Type" to contentType,
            "Accept" to "{{ output_encoding | escapeStringLiteral }}"
        ),
        body = body
    )
    return ATProtoResponse(raw.responseCode, raw.data?.let { {{ output_type }}(it) }, raw.errorBody)
    {% else %}
    return client.networkService.performRequest(
        method = "POST",
        endpoint = endpoint,
        queryItems = queryItems,
        headers = mapOf(
            "Content-Type" to contentType,
            "Accept" to "{{ output_encoding | escapeStringLiteral }}"
        ),
        body = body
    )
    {% endif %}
}
