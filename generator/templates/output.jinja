{% if is_type_alias %}
    public typealias Output = {{ type_alias_target }}
    {% else %}
    public struct Output: ATProtocolCodable {
        {% if properties and properties|length > 0 %}
        {% for prop in properties %}
        public let {{ prop.name|sanitizeKeyword }}: {{ prop.type }}{% if prop.optional %}?{% endif %}
        {% endfor %}
        {% elif properties is defined and properties|length == 0 %}
        // Empty output - no properties (response is {})
        {% else %}
        public let data: Data
        {% endif %}
        
        // Standard public initializer
        public init(
            {% if properties and properties|length > 0 %}
            {% for prop in properties %}
            {{ prop.name|sanitizeKeyword }}: {{ prop.type }}{% if prop.optional %}?{% if prop.wire_optional %} = nil{% endif %}{% endif %}{% if not loop.last %},{% endif %}
            {% endfor %}
            {% elif not (properties is defined and properties|length == 0) %}
            data: Data
            {% endif %}
        ) {
            {% if properties and properties|length > 0 %}
            {% for prop in properties %}
            self.{{ prop.name|sanitizeKeyword }} = {{ prop.name|sanitizeKeyword }}
            {% endfor %}
            {% elif not (properties is defined and properties|length == 0) %}
            self.data = data
            {% endif %}
        }
        
        public init(from decoder: Decoder) throws {
            {% if properties and properties|length > 0 %}
            let container = try decoder.container(keyedBy: CodingKeys.self)
            {%- for prop in properties %}
            {%- if prop.required_nullable %}
            guard container.contains(.{{ prop.name|sanitizeKeyword }}) else {
                throw DecodingError.keyNotFound(
                    CodingKeys.{{ prop.name|sanitizeKeyword }},
                    DecodingError.Context(
                        codingPath: container.codingPath,
                        debugDescription: "Missing required property '{{ prop.name }}'"
                    )
                )
            }
            {%- endif %}
            {% if prop.optional %}
            {% if prop.strict_decode %}
            if container.contains(.{{ prop.name|sanitizeKeyword }}), try !container.decodeNil(forKey: .{{ prop.name|sanitizeKeyword }}) {
                self.{{ prop.name|sanitizeKeyword }} = try Self.decodeStrictReference({{ prop.type }}.self, from: container, forKey: .{{ prop.name|sanitizeKeyword }}, allowedKeys: [{{ prop.strict_allowed_keys_literal }}], expectedTypeIdentifier: {{ prop.strict_type_identifier_literal }})
            } else {
                self.{{ prop.name|sanitizeKeyword }} = nil
            }
            {% elif prop.required_nullable %}
            self.{{ prop.name|sanitizeKeyword }} = try container.decodeIfPresent({{ prop.type }}.self, forKey: .{{ prop.name|sanitizeKeyword }})
            {% else %}
            do {
                self.{{ prop.name|sanitizeKeyword }} = try container.decodeIfPresent({{ prop.type }}.self, forKey: .{{ prop.name|sanitizeKeyword }})
            } catch {
                // Forward compatibility: a malformed optional field must not fail the whole response.
                LogManager.logWarning("Decoding error for optional property '{{ prop.name }}' — degrading to nil: \(error)")
                self.{{ prop.name|sanitizeKeyword }} = nil
            }
            {% endif %}
            {% else %}
            {% if prop.strict_decode %}
            self.{{ prop.name|sanitizeKeyword }} = try Self.decodeStrictReference({{ prop.type }}.self, from: container, forKey: .{{ prop.name|sanitizeKeyword }}, allowedKeys: [{{ prop.strict_allowed_keys_literal }}], expectedTypeIdentifier: {{ prop.strict_type_identifier_literal }})
            {% else %}
            self.{{ prop.name|sanitizeKeyword }} = try container.decode({{ prop.type }}.self, forKey: .{{ prop.name|sanitizeKeyword }})
            {% endif %}
            {% endif %}
            {%- endfor %}
            {% elif properties is defined and properties|length == 0 %}
            // Empty output - just validate it's an object by trying to get any container
            _ = try decoder.singleValueContainer()
            {% else %}
            let container = try decoder.container(keyedBy: CodingKeys.self)
            let data = try container.decode(Data.self, forKey: .data)
            self.data = data
            {% endif %}
        }
        
        public func encode(to encoder: Encoder) throws {
            {% if properties and properties|length > 0 %}
            var container = encoder.container(keyedBy: CodingKeys.self)
            {%- for prop in properties %}
            {% if prop.required_nullable %}
            try container.encode({{ prop.name|sanitizeKeyword }}, forKey: .{{ prop.name|sanitizeKeyword }})
            {% elif prop.optional %}
            // Encode optional property even if it's an empty array
            try container.encodeIfPresent({{ prop.name|sanitizeKeyword }}, forKey: .{{ prop.name|sanitizeKeyword }})
            {% else %}
            try container.encode({{ prop.name|sanitizeKeyword }}, forKey: .{{ prop.name|sanitizeKeyword }})
            {% endif %}
            {%- endfor %}
            {% elif properties is defined and properties|length == 0 %}
            // Empty output - encode empty object
            _ = encoder.singleValueContainer()
            {% else %}
            var container = encoder.container(keyedBy: CodingKeys.self)
            try container.encode(data, forKey: .data)
            {% endif %}
        }

        public func toCBORValue() throws -> Any {
            {% if properties and properties|length > 0 %}
            var map = OrderedCBORMap()

            {% for prop in properties %}
            {% if prop.required_nullable %}
            if let value = {{ prop.name|sanitizeKeyword }} {
                let {{ prop.name }}Value = try value.toCBORValue()
                map = map.adding(key: "{{ prop.name }}", value: {{ prop.name }}Value)
            } else {
                map = map.adding(key: "{{ prop.name }}", value: NSNull())
            }
            {% elif prop.optional %}
            if let value = {{ prop.name|sanitizeKeyword }} {
                // Encode optional property even if it's an empty array for CBOR
                let {{ prop.name }}Value = try value.toCBORValue()
                map = map.adding(key: "{{ prop.name }}", value: {{ prop.name }}Value)
            }
            {% else %}
            let {{ prop.name }}Value = try {{ prop.name|sanitizeKeyword }}.toCBORValue()
            map = map.adding(key: "{{ prop.name }}", value: {{ prop.name }}Value)
            {% endif %}
            {% endfor %}

            return map
            {% elif properties is defined and properties|length == 0 %}
            // Empty output - return empty CBOR map
            return OrderedCBORMap()
            {% else %}
            return data
            {% endif %}
        }
        
        {% if properties and properties|length > 0 %}
        {% if properties | selectattr('strict_decode') | list %}{% include 'strictRefDecoding.jinja' %}

        {% endif %}private enum CodingKeys: String, CodingKey {
            {%- for prop in properties %}
            case {{ prop.name|sanitizeKeyword }}
            {%- endfor %}
        }
        {% endif %}
    }
{% endif %}
