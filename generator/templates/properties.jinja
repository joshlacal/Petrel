{%- import 'decodeHelpers.jinja' as dh %}
{%- for prop in properties %}
        public let {{ prop.name|sanitizeKeyword }}: {{ prop.type }}{% if prop.optional %}?{% endif %}
        {%- endfor %}

        public init({% for prop in properties -%}
            {{ prop.name|sanitizeKeyword }}: {{ prop.type }}{% if prop.optional %}?{% if prop.wire_optional %} = nil{% endif %}{% endif %}{% if not loop.last %}, {% endif %}
        {%- endfor %}) {
            {%- for prop in properties %}
            self.{{ prop.name|sanitizeKeyword }} = {{ prop.name|sanitizeKeyword }}
            {%- endfor %}
        }

        public init(from decoder: Decoder) throws {
            self = try .init(_lexiconContainer: decoder.container(keyedBy: LexiconCodingKey.self)){# Assign via `.init` instead of delegating with `self.init(`: SwiftFormat's enumNamespaces rule will not convert a namespace struct to an enum if any nested type contains `self.init(` or `Self(`, so delegation would flip public namespaces (AppBskyFeedDefs, ...) from enum to struct, an API break. #}
        }

        /// Decodes from an already-opened keyed container. Generated unions pass the
        /// container they read `$type` from, so the object's keys are materialized once.
        public init(_lexiconContainer container: KeyedDecodingContainer<LexiconCodingKey>) throws {
            {%- for prop in properties %}
            {%- set key = dh.lexicon_key(prop) %}
            {%- if prop.required_nullable %}
            guard container.contains({{ key }}) else {
                throw DecodingError.keyNotFound(
                    CodingKeys.{{ prop.name|sanitizeKeyword }},
                    DecodingError.Context(
                        codingPath: container.codingPath,
                        debugDescription: "Missing required property '{{ prop.name }}'"
                    )
                )
            }
            {%- endif %}
            {% if prop.strict_decode -%}
            {% if prop.optional -%}
            if container.contains({{ key }}), try !container.decodeNil(forKey: {{ key }}) {
                self.{{ prop.name|sanitizeKeyword }} = try Self.decodeStrictReference({{ prop.type }}.self, from: container, forKey: {{ key }}, allowedKeys: [{{ prop.strict_allowed_keys_literal }}], expectedTypeIdentifier: {{ prop.strict_type_identifier_literal }})
            } else {
                self.{{ prop.name|sanitizeKeyword }} = nil
            }
            {%- else -%}
            self.{{ prop.name|sanitizeKeyword }} = try Self.decodeStrictReference({{ prop.type }}.self, from: container, forKey: {{ key }}, allowedKeys: [{{ prop.strict_allowed_keys_literal }}], expectedTypeIdentifier: {{ prop.strict_type_identifier_literal }})
            {%- endif %}
            {%- elif prop.optional -%}
            self.{{ prop.name|sanitizeKeyword }} = try {{ dh.decode_value(prop, 'decodeIfPresent', key) }}
            {%- else -%}
            self.{{ prop.name|sanitizeKeyword }} = try {{ dh.decode_value(prop, 'decode', key) }}
            {%- endif %}
            {%- endfor %}
        }

        public func encode(to encoder: Encoder) throws {
            var container = encoder.container(keyedBy: CodingKeys.self)
            {%- for prop in properties %}
            {% if prop.required_nullable -%}
            try container.encode({{ prop.name|sanitizeKeyword }}, forKey: .{{ prop.name|sanitizeKeyword }})
            {%- elif prop.optional -%}
            try container.encodeIfPresent({{ prop.name|sanitizeKeyword }}, forKey: .{{ prop.name|sanitizeKeyword }})
            {%- else -%}
            try container.encode({{ prop.name|sanitizeKeyword }}, forKey: .{{ prop.name|sanitizeKeyword }})
            {%- endif %}
            {%- endfor %}
        }

        public func hash(into hasher: inout Hasher) {
            {%- for prop in properties %}
            {%- if prop.optional %}
            if let value = {{ prop.name|sanitizeKeyword }} {
                hasher.combine(value)
            } else {
                hasher.combine(nil as Int?)
            }
            {%- else %}
            hasher.combine({{ prop.name|sanitizeKeyword }})
            {%- endif %}
            {%- endfor %}
        }

        public func isEqual(to other: any ATProtocolValue) -> Bool {
            guard let other = other as? Self else { return false }
            return self == other
        }

        public static func == (lhs: Self, rhs: Self) -> Bool {
            {%- for prop in properties %}
            if lhs.{{ prop.name|sanitizeKeyword }} != rhs.{{ prop.name|sanitizeKeyword }} {
                return false
            }
            {%- endfor %}
            return true
        }

        public func toCBORValue() throws -> Any {
            var map = OrderedCBORMap(minimumCapacity: {{ properties | length }})
            {%- for prop in properties %}
            {% if prop.required_nullable -%}
            if let value = {{ prop.name|sanitizeKeyword }} {
                let {{ prop.name }}Value = try value.toCBORValue()
                map.append(key: "{{ prop.name | escapeStringLiteral }}", value: {{ prop.name }}Value)
            } else {
                map.append(key: "{{ prop.name | escapeStringLiteral }}", value: NSNull())
            }
            {%- elif prop.optional -%}
            if let value = {{ prop.name|sanitizeKeyword }} {
                let {{ prop.name }}Value = try value.toCBORValue()
                map.append(key: "{{ prop.name | escapeStringLiteral }}", value: {{ prop.name }}Value)
            }
            {%- else -%}
            let {{ prop.name }}Value = try {{ prop.name|sanitizeKeyword }}.toCBORValue()
            map.append(key: "{{ prop.name | escapeStringLiteral }}", value: {{ prop.name }}Value)
            {%- endif %}
            {%- endfor %}
            return map
        }

        {%- if properties | selectattr('strict_decode') | list %}
        {% include 'strictRefDecoding.jinja' %}
        {%- endif %}

        private enum CodingKeys: String, CodingKey {
            {%- for prop in properties %}
            case {{ prop.name|sanitizeKeyword }}
            {%- endfor %}
        }
