    public struct Parameters: Parametrizable {
    {%- for prop in properties %}
        public let {{ prop.ident }}: {{ prop.type }}{% if prop.optional %}?{% endif %}
    {%- endfor %}
        
        public init({% for prop in properties %}
            {{ prop.ident }}: {{ prop.type }}{% if prop.optional %}?{% endif %}{% if prop.default_literal %} = {{ prop.default_literal }}{% elif prop.optional and prop.wire_optional %} = nil{% endif %}{% if not loop.last %}, {% endif %}
        {%- endfor %}
            ) {
            {% for prop in properties -%}
            self.{{ prop.ident }} = {{ prop.ident }}
            {% endfor %}
        }
        {%- if properties | selectattr('key_needs_raw_value') | list %}

        /// Query parameter names that are not valid Swift identifiers, keyed by the
        /// property that carries them.
        public static var queryParameterNames: [String: String] {
            [{% for prop in properties | selectattr('key_needs_raw_value') %}"{{ prop.ident_bare }}": "{{ prop.name | escapeStringLiteral }}"{% if not loop.last %}, {% endif %}{% endfor %}]
        }
        {%- endif %}
    }
