extension ATProtoClient.{{ template_namespace_name }} {
    // MARK: - {{ procedure_name | lowerCamelCase }}
    /// {{ (description or ('Calls `' ~ endpoint ~ '`.')) | escapeComment }}
    ///
    {%- if is_blob_upload %}
    /// The body is sent exactly as given: no re-encoding, no metadata stripping.
    ///
    /// - Parameters:
    ///   - data: The request body bytes
    ///   - mimeType: The MIME type of `data`, sent as `Content-Type`
    {%- if parameters_struct_name %}
    ///   - params: The query parameters for the request
    {%- endif %}
    {%- elif is_binary_data %}
    /// - Parameters:
    ///   - data: The request body bytes
    {%- if parameters_struct_name %}
    ///   - params: The query parameters for the request
    {%- endif %}
    {%- elif input_struct_name %}
    /// - Parameters:
    ///   - input: The request body
    {%- if parameters_struct_name %}
    ///   - params: The query parameters for the request
    {%- endif %}
    {%- elif parameters_struct_name %}
    /// - Parameter params: The query parameters for the request
    {%- endif %}
    /// - Returns: {% if output_type %}The HTTP status code (always 2xx) and the decoded response body.{% else %}The HTTP status code (always 2xx).{% endif %}
    /// - Throws: {% if has_errors %}`ATProtoError<{{ struct_name }}.Error>` when the server answers with an error this Lexicon declares, `ATProtoXRPCError` for any other non-2xx response{% else %}`ATProtoXRPCError` for a non-2xx response{% endif %} (its `error` and `message` are the server's `{error, message}` body), {% if output_type %}`XRPCResponseDecodingError` when a 2xx body does not match the output schema, {% endif %}and `NetworkError` for transport failures.
    public func {{ procedure_name | lowerCamelCase }}(
        {% if is_blob_upload %}
        data: Data,
        mimeType: String{% if parameters_struct_name %},
        params: {{ parameters_struct_name }}{% endif %}
        {% elif is_binary_data %}
        data: Data{% if parameters_struct_name %},
        params: {{ parameters_struct_name }}{% endif %}
        {% elif input_struct_name %}
        input: {{ input_struct_name }}{% if parameters_struct_name %},
        params: {{ parameters_struct_name }}{% endif %}
        {% elif parameters_struct_name %}
        params: {{ parameters_struct_name }}
        {% endif %}
    ) async throws -> {% if output_type %}(responseCode: Int, data: {{ output_type }}?){% else %}Int{% endif %} {
        let endpoint = "{{ endpoint | escapeStringLiteral }}"
        {% if is_blob_upload %}
        {{ 'var' if output_encoding else 'let' }} headers: [String: String] = [
            "Content-Type": mimeType,
            "Content-Length": "\(data.count)"
        ]
        {% elif is_binary_data %}
        {{ 'var' if output_encoding else 'let' }} headers: [String: String] = [
            "Content-Type": "{{ input_encoding | escapeStringLiteral }}",
            "Content-Length": "\(data.count)"
        ]
        {% else %}
        {{ 'var' if input_struct_name or output_encoding else 'let' }} headers: [String: String] = [:]
        {% if input_struct_name %}
        headers["Content-Type"] = "{{ input_encoding | escapeStringLiteral }}"
        {% endif %}
        {% endif %}
        {% if output_encoding %}
        headers["Accept"] = "{{ output_encoding | escapeStringLiteral }}"
        {% endif %}

        {% if not is_blob_upload and not is_binary_data %}
        let requestData: Data? = {% if input_struct_name %}try JSONEncoder().encode(input){% else %}nil{% endif %}
        {% endif %}
        {% if parameters_struct_name %}
        let queryItems = params.asQueryItems()
        {% else %}
        let queryItems: [URLQueryItem]? = nil
        {% endif %}
        let urlRequest = try await networkService.createURLRequest(
            endpoint: endpoint,
            method: "POST",
            headers: headers,
            body: {% if is_blob_upload or is_binary_data %}data{% else %}requestData{% endif %},
            queryItems: queryItems
        )

        // Determine service DID for this endpoint
        let serviceDID = await networkService.getServiceDID(for: "{{ endpoint | escapeStringLiteral }}")
        let proxyHeaders = serviceDID.map { ["atproto-proxy": $0] }
        let (responseData, response) = try await networkService.performRequestReturningHTTPErrorResponses(urlRequest, skipTokenRefresh: false, additionalHeaders: proxyHeaders)
        let responseCode = response.statusCode

        guard (200...299).contains(responseCode) else {
            {% if has_errors %}throw ATProtoErrorParser.xrpcError(data: responseData, response: response, declaredErrors: {{ struct_name }}.Error.self){% else %}throw ATProtoErrorParser.xrpcError(data: responseData, response: response){% endif %}
        }

        {% if output_type %}
        {% if output_encoding == "*/*" %}
        // Wildcard encoding ("*/*") — accept any Content-Type, including a missing one.
        {% else %}
        guard let contentType = response.allHeaderFields["Content-Type"] as? String else {
            throw NetworkError.invalidContentType(expected: "{{ output_encoding | escapeStringLiteral }}", actual: "nil")
        }

        if !contentType.lowercased().contains("{{ output_encoding.lower() | escapeStringLiteral }}") {
            throw NetworkError.invalidContentType(expected: "{{ output_encoding | escapeStringLiteral }}", actual: contentType)
        }
        {% endif %}

        {% if output_encoding == "application/json" %}do {
            let decodedData = try JSONDecoder().decode({{ output_type }}.self, from: responseData)
            return (responseCode, decodedData)
        } catch {
            throw XRPCResponseDecodingError(endpoint: endpoint, statusCode: responseCode, underlying: error)
        }{% else %}return (responseCode, {{ output_type }}(data: responseData)){% endif %}
        {% else %}
        return responseCode
        {% endif %}
    }
}
