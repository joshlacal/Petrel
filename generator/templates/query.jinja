{% if output_encoding == "text/event-stream" %}
extension ATProtoClient.{{ template_namespace_name }} {
    // MARK: - {{ query_name | lowerCamelCase }}
    /// {{ description | escapeComment }}
    /// {% if input_struct_name %}
    /// - Parameter input: The input parameters for the request
    /// {% endif %}
    /// - Returns: AsyncThrowingStream of events from the Server-Sent Events stream
    /// - Throws: NetworkError if the request fails or the connection cannot be established
    public func {{ query_name | lowerCamelCase }}({% if input_struct_name %}input: {{ input_struct_name }}{% endif %}) async throws -> AsyncThrowingStream<{{ output_type }}, Error> {
        let endpoint = "{{ endpoint | escapeStringLiteral }}"

        {% if input_struct_name %}
        let queryItems = input.asQueryItems()
        {% else %}
        let queryItems: [URLQueryItem]? = nil
        {% endif %}
        let urlRequest = try await networkService.createURLRequest(
            endpoint: endpoint,
            method: "GET",
            headers: ["Accept": "{{ output_encoding | escapeStringLiteral }}"],
            body: nil,
            queryItems: queryItems
        )

        // Determine service DID for this endpoint
        let serviceDID = await networkService.getServiceDID(for: "{{ endpoint | escapeStringLiteral }}")
        let proxyHeaders = serviceDID.map { ["atproto-proxy": $0] }

        return AsyncThrowingStream { continuation in
            let producerTask = Task {
                // Create URLSession with infinite timeouts for SSE long-lived connections
                let configuration = URLSessionConfiguration.default
                configuration.timeoutIntervalForRequest = .infinity
                configuration.timeoutIntervalForResource = .infinity
                configuration.waitsForConnectivity = true
                let sseSession = URLSession(configuration: configuration)
                defer {
                    sseSession.invalidateAndCancel()
                }

                do {
                    // Use networkService to prepare authenticated streaming request with OAuth/DPoP
                    let preparedRequest = try await networkService.prepareStreamingRequest(
                        urlRequest,
                        additionalHeaders: proxyHeaders
                    )
                    defer {
                        preparedRequest.releaseAuthenticationLease()
                    }

                    let (bytes, response) = try await sseSession.bytes(for: preparedRequest.request)
                    preparedRequest.releaseAuthenticationLease()
                    guard let httpResponse = response as? HTTPURLResponse else {
                        continuation.finish(throwing: NetworkError.invalidResponse(description: "Non-HTTP response"))
                        return
                    }

                    guard httpResponse.statusCode == 200 else {
                        continuation.finish(throwing: NetworkError.serverError(code: httpResponse.statusCode, message: "SSE connection failed"))
                        return
                    }

                    guard let contentType = httpResponse.value(forHTTPHeaderField: "Content-Type"),
                          contentType.lowercased().contains("text/event-stream") else {
                        continuation.finish(throwing: NetworkError.invalidContentType(expected: "text/event-stream", actual: httpResponse.value(forHTTPHeaderField: "Content-Type") ?? "nil"))
                        return
                    }

                    // Parse SSE stream
                    var buffer = ""
                    let decoder = JSONDecoder()

                    for try await byte in bytes {
                        let char = Character(UnicodeScalar(byte))
                        buffer.append(char)

                        // SSE events are delimited by double newline
                        if buffer.hasSuffix("\n\n") {
                            // Parse the event
                            let lines = buffer.split(separator: "\n", omittingEmptySubsequences: false)

                            for line in lines {
                                let lineStr = String(line)

                                // SSE data lines start with "data: "
                                if lineStr.hasPrefix("data: ") {
                                    let jsonString = String(lineStr.dropFirst(6))

                                    if let jsonData = jsonString.data(using: .utf8) {
                                        do {
                                            let event = try decoder.decode({{ output_type }}.self, from: jsonData)
                                            continuation.yield(event)
                                        } catch {
                                            LogManager.logError("Failed to decode SSE event for {{ endpoint | escapeStringLiteral }}: \(error)")
                                            // Continue processing other events
                                        }
                                    }
                                }
                                // Ignore comment lines (start with ":") and other SSE fields
                            }

                            buffer = ""
                        }
                    }

                    // Stream ended normally
                    continuation.finish()
                } catch {
                    continuation.finish(throwing: error)
                }
            }

            continuation.onTermination = { @Sendable _ in
                producerTask.cancel()
            }
        }
    }
}
{% else %}
extension ATProtoClient.{{ template_namespace_name }} {
    // MARK: - {{ query_name | lowerCamelCase }}
    /// {{ (description or ('Calls `' ~ endpoint ~ '`.')) | escapeComment }}
    ///
    {%- if input_struct_name %}
    /// - Parameter input: The input parameters for the request
    {%- endif %}
    /// - Returns: {% if output_type %}The HTTP status code (always 2xx) and the decoded response body.{% else %}The HTTP status code (always 2xx).{% endif %}
    /// - Throws: {% if has_errors %}`ATProtoError<{{ struct_name }}.Error>` when the server answers with an error this Lexicon declares, `ATProtoXRPCError` for any other non-2xx response{% else %}`ATProtoXRPCError` for a non-2xx response{% endif %} (its `error` and `message` are the server's `{error, message}` body), `XRPCResponseDecodingError` when a 2xx body does not match the output schema, and `NetworkError` for transport failures.
    public func {{ query_name | lowerCamelCase }}({% if input_struct_name %}input: {{ input_struct_name }}{% endif %}) async throws -> {% if output_type %}(responseCode: Int, data: {{ output_type }}?){% else %}Int{% endif %} {
        let endpoint = "{{ endpoint | escapeStringLiteral }}"

        {% if input_struct_name %}
        let queryItems = input.asQueryItems()
        {% else %}
        let queryItems: [URLQueryItem]? = nil
        {% endif %}
        let urlRequest = try await networkService.createURLRequest(
            endpoint: endpoint,
            method: "GET",
            headers: {% if output_type %}["Accept": "{{ output_encoding | escapeStringLiteral }}"]{% else %}[:]{% endif %},
            body: nil,
            queryItems: queryItems
        )

        // Determine service DID for this endpoint
        let serviceDID = await networkService.getServiceDID(for: "{{ endpoint | escapeStringLiteral }}")
        let proxyHeaders = serviceDID.map { ["atproto-proxy": $0] }
        let (responseData, response) = try await networkService.performRequestReturningHTTPErrorResponses(urlRequest, skipTokenRefresh: false, additionalHeaders: proxyHeaders)
        let responseCode = response.statusCode

        guard (200...299).contains(responseCode) else {
            {% if has_errors %}throw ATProtoErrorParser.xrpcError(data: responseData, response: response, declaredErrors: {{ struct_name }}.Error.self){% else %}throw ATProtoErrorParser.xrpcError(data: responseData, response: response){% endif %}
        }

        {% if not output_type %}
        return responseCode
        {% else %}
        {% if output_encoding == "*/*" %}
        // Wildcard encoding ("*/*") — accept any Content-Type, including a missing one.
        {% else %}
        guard let contentType = response.value(forHTTPHeaderField: "Content-Type") else {
            throw NetworkError.invalidContentType(expected: "{{ output_encoding | escapeStringLiteral }}", actual: "nil")
        }

        if !contentType.lowercased().contains("{{ output_encoding.lower() | escapeStringLiteral }}") {
            throw NetworkError.invalidContentType(expected: "{{ output_encoding | escapeStringLiteral }}", actual: contentType)
        }
        {% endif %}

        {% if output_encoding == "application/json" %}do {
            let decodedData = try JSONDecoder().decode({{ output_type }}.self, from: responseData)
            return (responseCode, decodedData)
        } catch {
            throw XRPCResponseDecodingError(endpoint: endpoint, statusCode: responseCode, underlying: error)
        }{% else %}return (responseCode, {{ output_type }}(data: responseData)){% endif %}
        {% endif %}
    }
}
{% endif %}
