{% for prop in properties %}
{% if prop.description %}
{{ prop.description | escape_doc | indent(4, true) }}
{% endif %}
    pub {{ prop.ident }}: {{ prop.rust_type }},
{% endfor %}
}

impl Parameters {
    pub fn new({% for p in required_params %}{{ p.ident }}: {{ p.rust_type }}{% if not loop.last %}, {% endif %}{% endfor %}) -> Self {
        Self {
{% for prop in properties %}
{% if prop.default_expr %}
            {{ prop.ident }}: {{ prop.default_expr }},
{% elif prop.in_new_params %}
            {{ prop.ident }},
{% else %}
            {{ prop.ident }}: None,
