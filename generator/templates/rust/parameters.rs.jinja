}
{% if all_optional %}

impl Default for Parameters {
    fn default() -> Self {
        Self::new()
    }
}
{% endif %}

impl petrel_core::ToQueryParams for Parameters {
    fn to_query_params(&self, {% if not properties %}_{% endif %}out: &mut Vec<(&'static str, String)>) {
{% for prop in properties %}
{% if prop.is_array %}
{% if prop.is_option %}
        if let Some(items) = &self.{{ prop.ident }} {
            petrel_core::xrpc::push_array_param(out, {{ prop.wire_literal }}, items);
        }
{% else %}
        petrel_core::xrpc::push_array_param(out, {{ prop.wire_literal }}, &self.{{ prop.ident }});
{% endif %}
{% elif prop.is_option %}
        petrel_core::xrpc::push_optional_param(out, {{ prop.wire_literal }}, self.{{ prop.ident }}.as_ref());
{% else %}
        petrel_core::xrpc::push_param(out, {{ prop.wire_literal }}, &self.{{ prop.ident }});
{% endif %}
{% endfor %}
    }
}
